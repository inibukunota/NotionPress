---
import { config } from "../config/config";
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="masthead">
      <a class="site-brand" href="/">{config.site.name}</a>
      <p class="site-description">{config.site.description}</p>
      <time class="masthead-date datetime" datetime={new Date().toISOString().slice(0, 10)}>
        {new Intl.DateTimeFormat(config.site.locale, {
          weekday: "long",
          day: "numeric",
          month: "long",
          year: "numeric",
        }).format(new Date())}
      </time>
    </div>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
    </nav>

    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
    </nav>
  </div>
</header>
