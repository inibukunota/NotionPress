---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StructuredData from "../components/StructuredData.astro";
import { articleSchema, breadcrumbSchema } from "../lib/seo/structured-data";
import { siteConfig } from "../config/site";
import FormattedDate from "../components/FormattedDate.astro";
import { getPublishedPosts } from "../lib/content";

const p = Astro.props;
const url = new URL(`/blog/${p.slug}/`, siteConfig.url).toString();
const data = [
  articleSchema(p),
  breadcrumbSchema([
    { name: siteConfig.name, url: new URL("/", siteConfig.url).toString() },
    { name: "Blog", url: new URL("/blog/", siteConfig.url).toString() },
    { name: p.title, url },
  ]),
];

const all = await getPublishedPosts();
const related = all
  .filter(
    (x) =>
      x.data.slug !== p.slug &&
      (x.data.category === p.category || x.data.tags.some((t: string) => p.tags.includes(t)))
  )
  .slice(0, 3);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <BaseHead
      title={p.title}
      description={p.description}
      image={p.heroImage}
      type="article"
      publishedTime={p.publishedDate.toISOString()}
      modifiedTime={p.updatedDate?.toISOString()}
      author={p.author}
      section={p.category}
      tags={p.tags}
    />
    <StructuredData data={data} />
  </head>
  <body>
    <Header />

    <main class="personal-home">
      <article class="personal-article">
        <header class="personal-article-header">
          <div class="eyebrow">{p.category}</div>
          <h1>{p.title}</h1>
          <p class="story-excerpt">{p.description}</p>
          <div class="story-meta">
            <span>By {p.author}</span>
            <FormattedDate date={p.publishedDate} />
            {p.updatedDate && <span>Updated <FormattedDate date={p.updatedDate} /></span>}
            {p.readingTime && <span>{p.readingTime} min read</span>}
          </div>
        </header>

        {p.heroImage && (
          <figure class="personal-article-image">
            <img src={p.heroImage} alt={p.title} width="1200" height="675" fetchpriority="high" decoding="async" />
          </figure>
        )}

        <div class="story-body">
          <slot />
        </div>

        <div class="share">
          <span>Share</span>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`}>Facebook</a>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(p.title)}`}>X</a>
        </div>

        {p.tags.length > 0 && (
          <footer class="story-footer">
            <div class="tags">
              {p.tags.map((tag: string) => (
                <a href={`/tag/${tag.toLowerCase().replace(/[^a-z0-9]+/g, "-")}/`}>#{tag}</a>
              ))}
            </div>
          </footer>
        )}

        {related.length > 0 && (
          <section class="related">
            <h2>Related posts</h2>
            <div class="related-posts">
              {related.map((post) => (
                <article class="personal-post">
                  {post.data.heroImage && (
                    <a class="personal-post-image" href={`/blog/${post.data.slug}/`}>
                      <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
                    </a>
                  )}
                  <div class="personal-post-copy">
                    <div class="eyebrow">{post.data.category}</div>
                    <h3><a href={`/blog/${post.data.slug}/`}>{post.data.title}</a></h3>
                    <p>{post.data.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}
      </article>
    </main>

    <Footer />
  </body>
</html>
