---
import BaseLayout from "../../layouts/BaseLayout.astro"; import {getPublishedPosts} from "../../lib/content"; import {collectionPageSchema} from "../../lib/seo/structured-data"; import {siteConfig} from "../../config/site";
const posts=await getPublishedPosts();
---
<BaseLayout title={`Blog | ${siteConfig.name}`} description={`Latest posts from ${siteConfig.name}.`} structuredData={collectionPageSchema("Blog",`Latest posts from ${siteConfig.name}.`,siteConfig.url+"/blog/")}><main><section class="page-intro"><h1>Blog</h1><p>Latest posts from {siteConfig.name}.</p></section><div class="story-grid">{posts.map(post=><article class="story-card"><a href={`/blog/${post.data.slug}/`}>{post.data.heroImage&&<img src={post.data.heroImage} alt={post.data.title}/>}<div class="story-card-body"><div class="story-meta">{post.data.category} · {post.data.publishedDate.toLocaleDateString("en-MY")}</div><h2>{post.data.title}</h2><p>{post.data.description}</p></div></a></article>)}</div></main></BaseLayout>