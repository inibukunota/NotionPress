---
import {getPublishedPosts,slugify} from "../../lib/content"; import BaseLayout from "../../layouts/BaseLayout.astro"; import {collectionPageSchema} from "../../lib/seo/structured-data"; import {siteConfig} from "../../config/site";
export async function getStaticPaths(){const posts=await getPublishedPosts();return [...new Set(posts.map(p=>p.data.author))].map(author=>({params:{slug:slugify(author)},props:{author}}));}
const {author}=Astro.props; const posts=(await getPublishedPosts()).filter(p=>p.data.author===author);
---
<BaseLayout title={`By ${author} | ${siteConfig.name}`} description={`Posts by ${author}.`} structuredData={collectionPageSchema(author,`Posts by ${author}.`,siteConfig.url+`/author/${slugify(author)}/`)}><main><section class="page-intro"><h1>By {author}</h1></section><div class="story-grid">{posts.map(post=><article class="story-card"><a href={`/blog/${post.data.slug}/`}>{post.data.heroImage&&<img src={post.data.heroImage} alt={post.data.title}/>}<div class="story-card-body"><h2>{post.data.title}</h2><p>{post.data.description}</p></div></a></article>)}</div></main></BaseLayout>