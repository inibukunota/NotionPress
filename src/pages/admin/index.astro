---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="CMS" description="NotionPress CMS controls">
  <main class="cms-admin">
    <section class="cms-panel" aria-labelledby="cms-title">
      <p class="eyebrow">NotionPress CMS</p>
      <h1 id="cms-title">Site controls</h1>
      <p class="intro">
        Run the Notion sync workflow manually. Published changes are synced to
        GitHub and the resulting content commit triggers the Cloudflare Pages build.
      </p>

      <div class="control">
        <label for="rebuild-key">Rebuild key</label>
        <input
          id="rebuild-key"
          type="password"
          autocomplete="off"
          placeholder="Enter your CMS rebuild key"
        />
        <p class="hint">
          The key is stored only in this browser session and is never committed to the site.
        </p>
      </div>

      <button id="rebuild-button" type="button">
        <span class="button-label">Sync &amp; rebuild</span>
      </button>

      <p id="status" class="status" role="status" aria-live="polite"></p>
    </section>
  </main>
</BaseLayout>

<script>
  const keyInput = document.querySelector("#rebuild-key");
  const button = document.querySelector("#rebuild-button");
  const status = document.querySelector("#status");

  if (keyInput instanceof HTMLInputElement) {
    const savedKey = sessionStorage.getItem("notionpress-rebuild-key");
    if (savedKey) keyInput.value = savedKey;
  }

  if (
    button instanceof HTMLButtonElement &&
    keyInput instanceof HTMLInputElement &&
    status instanceof HTMLElement
  ) {
    button.addEventListener("click", async () => {
      const key = keyInput.value.trim();

      if (!key) {
        status.textContent = "Enter the rebuild key first.";
        status.dataset.state = "error";
        keyInput.focus();
        return;
      }

      button.disabled = true;
      status.textContent = "Starting GitHub Actions…";
      status.dataset.state = "working";

      try {
        const response = await fetch("/api/rebuild", {
          method: "POST",
          headers: {
            "X-Rebuild-Key": key,
          },
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || "Unable to start the workflow.");
        }

        sessionStorage.setItem("notionpress-rebuild-key", key);
        status.textContent =
          "Workflow started. GitHub will sync Notion, commit changes, and trigger the site build.";
        status.dataset.state = "success";
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "Something went wrong.";
        status.dataset.state = "error";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .cms-admin {
    width: min(100% - 2rem, 720px);
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .cms-panel {
    border-top: 1px solid var(--border-color, #ddd);
    padding-top: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
  }

  .intro {
    max-width: 60ch;
    margin: 1rem 0 2rem;
    line-height: 1.6;
  }

  .control {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  label {
    font-size: 0.875rem;
    font-weight: 700;
  }

  input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem;
    border: 1px solid var(--border-color, #ccc);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .hint {
    margin: 0;
    color: var(--muted-color, #666);
    font-size: 0.8125rem;
  }

  button {
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button:hover:not(:disabled) {
    background: currentColor;
    color: var(--background-color, #fff);
  }

  button:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .status {
    min-height: 1.5em;
    margin: 1rem 0 0;
    line-height: 1.5;
  }

  .status[data-state="working"] {
    font-weight: 600;
  }

  .status[data-state="success"] {
    font-weight: 600;
  }

  .status[data-state="error"] {
    font-weight: 600;
  }
</style>
