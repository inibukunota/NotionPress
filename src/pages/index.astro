---
import BaseLayout from "../layouts/BaseLayout.astro"; import {getPublishedPosts} from "../lib/content"; import {websiteSchema} from "../lib/seo/structured-data"; import {siteConfig} from "../config/site";
const posts=await getPublishedPosts();
---
<BaseLayout title={siteConfig.name} description={siteConfig.description} structuredData={websiteSchema()}><main><section class="page-intro"><h1>{siteConfig.name}</h1><p>{siteConfig.description}</p></section>{posts.length?<div class="story-grid">{posts.slice(0,6).map(post=><article class="story-card"><a href={`/blog/${post.data.slug}/`}>{post.data.heroImage&&<img src={post.data.heroImage} alt={post.data.title} loading="lazy"/>}<div class="story-card-body"><div class="story-meta">{post.data.category}</div><h2>{post.data.title}</h2><p>{post.data.description}</p></div></a></article>)}</div>:<p class="empty-state">No published posts yet.</p>}</main></BaseLayout>