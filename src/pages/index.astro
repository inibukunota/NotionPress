---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/content";
import { websiteSchema } from "../lib/seo/structured-data";
import { siteConfig } from "../config/site";

const posts = await getPublishedPosts();
const featured = posts[0];
const gridPosts = posts.slice(1, 5);
const listPosts = posts.slice(5, 10);
const meta = (post: typeof posts[number]) => `${post.data.category} · ${post.data.publishedDate.toLocaleDateString("en-MY")} · ${Math.max(1, Math.ceil((post.body?.trim().split(/\\s+/).length || 0) / 200))} min read`;
---
<BaseLayout title={siteConfig.name} description={siteConfig.description} structuredData={websiteSchema()}>
  <main class="home">
    {featured ? (
      <>
        <section class="home-feature" aria-labelledby="featured-title">
          <div class="home-feature-copy">
            <div class="eyebrow">{featured.data.category}</div>
            <h1 id="featured-title"><a href={`/blog/${featured.data.slug}/`}>{featured.data.title}</a></h1>
            <p class="dek">{featured.data.description}</p>
            <div class="story-meta">{meta(featured)} · By {featured.data.author}</div>
          </div>
          {featured.data.heroImage && <a class="home-feature-image" href={`/blog/${featured.data.slug}/`} aria-label={featured.data.title}><img src={featured.data.heroImage} alt={featured.data.title} fetchpriority="high" /></a>}
        </section>
        {gridPosts.length > 0 && (
          <>
            <div class="section-heading"><h2>Latest Stories</h2><a href="/blog/">View all</a></div>
            <section class="story-grid" aria-label="Latest stories">
              {gridPosts.map(post => <article class="story-card">
                {post.data.heroImage && <a class="story-card-image" href={`/blog/${post.data.slug}/`}><img src={post.data.heroImage} alt={post.data.title} loading="lazy" /></a>}
                <div class="story-card-body">
                  <div class="eyebrow">{post.data.category}</div>
                  <h3><a href={`/blog/${post.data.slug}/`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  <div class="story-meta">{meta(post)}</div>
                </div>
              </article>)}
            </section>
          </>
        )}
        {listPosts.length > 0 && (
          <section class="story-list" aria-labelledby="more-stories">
            <div class="section-heading"><h2 id="more-stories">More Stories</h2></div>
            {listPosts.map(post => <article class="story-row">
              {post.data.heroImage && <a class="story-row-image" href={`/blog/${post.data.slug}/`}><img src={post.data.heroImage} alt={post.data.title} loading="lazy" /></a>}
              <div>
                <div class="eyebrow">{post.data.category}</div>
                <h3><a href={`/blog/${post.data.slug}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <div class="story-meta">{meta(post)}</div>
              </div>
            </article>)}
          </section>
        )}
      </>
    ) : <p class="empty-state">No published posts yet.</p>}
  </main>
</BaseLayout>