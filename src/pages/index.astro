---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/content";
import { websiteSchema } from "../lib/seo/structured-data";
import { siteConfig } from "../config/site";

const posts = (await getPublishedPosts()).slice(0, 5);
const meta = (post: typeof posts[number]) =>
  `${post.data.category} · ${post.data.publishedDate.toLocaleDateString("en-MY")} · ${Math.max(1, Math.ceil((post.body?.trim().split(/\s+/).length || 0) / 200))} min read`;
---

<BaseLayout title={siteConfig.name} description={siteConfig.description} structuredData={websiteSchema()}>
  <main class="personal-home">
    <section class="personal-posts" aria-labelledby="latest-heading">
      <div class="section-heading">
        <h1 id="latest-heading">Latest Posts</h1>
        <a href="/blog/">All posts</a>
      </div>

      {posts.map((post) => (
        <article class="personal-post">
          {post.data.heroImage && (
            <a class="personal-post-image" href={`/blog/${post.data.slug}/`} aria-label={post.data.title}>
              <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
            </a>
          )}
          <div class="personal-post-copy">
            <div class="eyebrow">{post.data.category}</div>
            <h2><a href={`/blog/${post.data.slug}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="story-meta">{meta(post)} · By {post.data.author}</div>
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
