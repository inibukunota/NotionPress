---
import {getPublishedPosts,slugify} from "../../lib/content"; import BaseLayout from "../../layouts/BaseLayout.astro"; import {collectionPageSchema} from "../../lib/seo/structured-data"; import {siteConfig} from "../../config/site";
export async function getStaticPaths(){const posts=await getPublishedPosts();return [...new Set(posts.flatMap(p=>p.data.tags))].map(tag=>({params:{slug:slugify(tag)},props:{tag}}));}
const {tag}=Astro.props; const posts=(await getPublishedPosts()).filter(p=>p.data.tags.includes(tag));
---
<BaseLayout title={`#${tag} | ${siteConfig.name}`} description={`Posts tagged ${tag}.`} structuredData={collectionPageSchema("#"+tag,`Posts tagged ${tag}.`,siteConfig.url+`/tag/${slugify(tag)}/`)}>
  <main class="personal-listing">
    <section class="personal-posts">
      <div class="section-heading"><h1>#{tag}</h1></div>
      {posts.map(post=><article class="personal-post">
        {post.data.heroImage&&<a class="personal-post-image" href={`/blog/${post.data.slug}/`}><img src={post.data.heroImage} alt={post.data.title} loading="lazy"/></a>}
        <div class="personal-post-copy">
          <div class="eyebrow">{post.data.category}</div>
          <h2><a href={`/blog/${post.data.slug}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </div>
      </article>)}
    </section>
  </main>
</BaseLayout>