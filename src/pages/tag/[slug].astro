---
import {getPublishedPosts,slugify} from "../../lib/content"; import BaseLayout from "../../layouts/BaseLayout.astro"; import {collectionPageSchema} from "../../lib/seo/structured-data"; import {siteConfig} from "../../config/site";
export async function getStaticPaths(){const posts=await getPublishedPosts();return [...new Set(posts.flatMap(p=>p.data.tags))].map(tag=>({params:{slug:slugify(tag)},props:{tag}}));}
const {tag}=Astro.props; const posts=(await getPublishedPosts()).filter(p=>p.data.tags.includes(tag));
---
<BaseLayout title={`#${tag} | ${siteConfig.name}`} description={`Posts tagged ${tag}.`} structuredData={collectionPageSchema("#"+tag,`Posts tagged ${tag}.`,siteConfig.url+`/tag/${slugify(tag)}/`)}><main><section class="page-intro"><h1>#{tag}</h1></section><div class="story-grid">{posts.map(post=><article class="story-card"><a href={`/blog/${post.data.slug}/`}>{post.data.heroImage&&<img src={post.data.heroImage} alt={post.data.title}/>}<div class="story-card-body"><h2>{post.data.title}</h2><p>{post.data.description}</p></div></a></article>)}</div></main></BaseLayout>